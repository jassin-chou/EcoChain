# EcoChain 環境變數
# 本地開發直接用這個就可以跑
# 部署到 Azure 的話，在 Azure App Service 設定環境變數，不用改這裡

# Firebase（沒有金鑰就留這樣，存檔功能會停用但其他功能正常）
FIREBASE_CREDS_PATH=serviceAccountKey.json

# Auth token 簽章金鑰（本地開發用預設值就好）
TOKEN_SECRET=local-dev-token-secret

# /retrain 端點密碼（本地開發用預設值就好）
RETRAIN_SECRET=local-dev-retrain-secret

# CORS（本地開發不用設，部署才需要填前端網址）
# ALLOW_ORIGINS=https://your-frontend-domain.example
